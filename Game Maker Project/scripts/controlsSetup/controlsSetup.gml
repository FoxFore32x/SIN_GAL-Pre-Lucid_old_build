function controlsSetup() {
	bufferTime = 3;

	//Directions

	//Left
	leftKeyBuffered = 0;
	leftKeyBufferTimer = 0;

	//Right
	rightKeyBuffered = 0;
	rightKeyBufferTimer = 0;

	//Up
	upKeyBuffered = 0;
	upKeyBufferTimer = 0;

	//Down
	downKeyBuffered = 0;
	downKeyBufferTimer = 0;

	//Jump
	jumpKeyBuffered = 0;
	jumpKeyBufferTimer = 0;

	jumpMantKeyBuffered = 0;
	jumpMantKeyBufferTimer = 0;

	//Attack
	lattKeyBuffered = 0;
	lattKeyBufferTimer = 0;

	hattKeyBuffered = 0;
	hattKeyBufferTimer = 0;

	//Special

	spKeyBuffered = 0;
	spKeyBufferTimer = 0;

	//Dash

	dashKeyBuffered = 0;
	dashKeyBufferTimer = 0;

	//Parry

	parryKeyBuffered = 0;
	parryKeyBufferTimer = 0;

	//Wall

	wallKeyBuffered = 0;
	wallKeyBufferTimer = 0;



}
